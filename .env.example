# ---------------------------------------------------------------------------
# LLM provider keys (design-time case generation + play-time narration)
# ---------------------------------------------------------------------------
# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Configuration — required when SATORI_NARRATOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---------------------------------------------------------------------------
# Narrator (P2-H08) — read by satori-api at startup
# ---------------------------------------------------------------------------
# mock (default) | anthropic. Invalid or incomplete live config falls back
# to mock with a logged error — the game always runs.
SATORI_NARRATOR_PROVIDER=mock

# Model for live narration (default: claude-sonnet-4-6)
#SATORI_NARRATOR_MODEL=claude-sonnet-4-6
